// Prisma schema for KOMYUT MVP

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  username             String   @unique
  name                 String
  avatarUrl            String?
  coverUrl             String?
  bio                  String?
  homeArea             String?
  passwordHash         String?
  reputationPoints     Int      @default(0)
  verifiedAnswersCount Int      @default(0)
  role                 String   @default("user") // "user", "moderator", "admin"
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  posts             Post[]
  answers           Answer[]
  votes             Vote[]
  bookmarks         Bookmark[]
  notifications     Notification[] @relation("UserNotifications")
  sentNotifications Notification[] @relation("ActorNotifications")
  reports           Report[]

  @@map("users")
}

enum ProcessingStatus {
  PENDING
  EMBEDDED
  FAILED
}

enum ConfidenceTier {
  VERIFIED
  LIKELY
  UNCONFIRMED
}

model Post {
  id                   String           @id @default(uuid())
  authorId             String
  author               User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title                String
  body                 String
  origin               String
  destination          String
  region               String           @default("Metro Manila")
  status               String           @default("unanswered") // "unanswered", "answered", "verified", "pinned"
  upvoteCount          Int              @default(0)
  answerCount          Int              @default(0)
  isCommentingDisabled Boolean          @default(false)
  isAnonymous          Boolean          @default(false)
  processingStatus     ProcessingStatus @default(PENDING)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  answers       Answer[]
  votes         Vote[]
  bookmarks     Bookmark[]
  tags          PostTag[]
  aiSuggestions AISuggestion[]
  reports       Report[]
  embedding     Embedding?

  @@map("posts")
}

model Answer {
  id                       String           @id @default(uuid())
  postId                   String
  post                     Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId                 String
  author                   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId                 String?
  parent                   Answer?          @relation("AnswerReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies                  Answer[]         @relation("AnswerReplies")
  body                     String
  isVerified               Boolean          @default(false)
  upvoteCount              Int              @default(0)
  processingStatus         ProcessingStatus @default(PENDING)
  lastConfirmedAt          DateTime         @default(now())
  isSpam                   Boolean          @default(false)
  isOfftopic               Boolean          @default(false)
  isLowEffort              Boolean          @default(false)
  classificationConfidence Float?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  votes         Vote[]
  reports       Report[]
  embedding     Embedding?
  aiSuggestions AISuggestion[]

  @@map("answers")
}

model Vote {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String?
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId  String?
  answer    Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  direction String   // "up" | "down"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, postId])
  @@unique([userId, answerId])
  @@map("votes")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@map("bookmarks")
}

enum TagType {
  AREA
  TRANSPORT
  CUSTOM
}

model Tag {
  id         String    @id @default(uuid())
  name       String    @unique
  slug       String    @default("") @unique
  aliases    String[]  @default([])
  type       TagType   @default(TRANSPORT)
  usageCount Int       @default(0) @map("usage_count")
  createdAt  DateTime  @default(now())

  posts      PostTag[]

  @@map("tags")
}

model PostTag {
  id     String @id @default(uuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([postId, tagId])
  @@map("post_tags")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type      String   // "NEW_ANSWER", "UPVOTE", "ACCEPTED", "MENTION"
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AISuggestion {
  id                      String         @id @default(uuid())
  postId                  String
  post                    Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId                String
  answer                  Answer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  confidenceScore         Float          @default(0.0)
  confidenceTier          ConfidenceTier
  similarityScore         Float
  similarityThresholdUsed Float?
  minConfidenceUsed       Float?
  isCrossMode             Boolean        @default(false)
  wasHelpful              Boolean?
  createdAt               DateTime       @default(now())

  @@map("ai_suggestions")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId   String?
  answer     Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("pending") // "pending", "reviewed", "dismissed", "actioned"
  createdAt  DateTime @default(now())

  @@map("reports")
}

model Embedding {
  id        String   @id @default(uuid())
  postId    String?  @unique
  answerId  String?  @unique
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  answer    Answer?  @relation(fields: [answerId], references: [id], onDelete: Cascade)
  embedding Unsupported("vector(1536)")
  model     String   @default("text-embedding-3-small")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("embeddings")
}
